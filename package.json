{
  "name": "copyright-management",
  "private": true,
  "description": "Copyright Management — MERN stack (Node 12 / Firefox 52 ESR compatible)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && nodemon src/index.js",
    "dev:client": "cd client && webpack-dev-server --mode development",
    "build": "cd client && webpack --mode production",
    "start": "cd server && node src/index.js",
    "seed": "cd server && node src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "chart.js": "^4.4.7",
    "core-js": "^3.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.15.4",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "3.5.4",
    "morgan": "^1.10.0",
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "react-router-dom": "^6.28.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^8.3.0",
    "clean-webpack-plugin": "^3.0.0",
    "concurrently": "^6.5.1",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^5.2.7",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^4.5.2",
    "nodemon": "^2.0.22",
    "style-loader": "^2.0.0",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  },
  "engines": {
    "node": ">=12"
  }
}
